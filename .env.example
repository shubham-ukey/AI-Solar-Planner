# Browser-visible Vite variables (PUBLIC). Do not put secrets in VITE_* variables.
VITE_ENABLE_GOOGLE_MAPS=false
VITE_GOOGLE_MAPS_API_KEY=
VITE_ENABLE_SOLAR_API=false
VITE_ENABLE_AI=false
VITE_AI_PROXY_URL=
VITE_ENABLE_EMAILJS=false
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_ENABLE_FIREBASE=false
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
# DEMO ONLY: this is exposed in the browser bundle and is not secure.
VITE_ADMIN_DEMO_PASSWORD=

# Server-side variables for api/ai.js (SECRET/server-only; set in Vercel Project Settings).
AI_PROVIDER_API_KEY=
AI_PROVIDER_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=

# Deployment notes:
# - Restrict Google Maps browser key by HTTP referrers to localhost during development and your exact Vercel domains in production.
# - EmailJS identifiers/public key are intentionally public; configure allowed origins and template settings in EmailJS.
# - Firebase web config is public, but Firestore rules and admin custom claims are the security boundary.
# - AI_PROVIDER_API_KEY must never use a VITE_ prefix or be exposed to tmentation: 200 requests/month, 2 the browser.
# - EmailJS free plan docuemplates, 50 KB/request; no dynamic attachment allowance.
# - Phase 6 email sends summary + share link, not a PDF attachment.
